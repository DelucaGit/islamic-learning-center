# Copy values into your shell, IDE run configuration, or a local file that is NOT committed.
# Never commit real passwords or RDS URLs with embedded credentials.

# Active Spring profile (e.g. local, prod)
SPRING_PROFILES_ACTIVE=local

# PostgreSQL JDBC URL (local pgAdmin database or AWS RDS)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lms_db

SPRING_DATASOURCE_USERNAME=lms_user
# Set your real password in the environment only — never commit this file with a real value.
SPRING_DATASOURCE_PASSWORD=

# HTTP port (optional)
SERVER_PORT=8080
