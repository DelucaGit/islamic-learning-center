# Variable names only — set values on your machine (Windows env, IDE run config, etc.).
# Do not put real passwords or URLs in a committed copy of this file.
#
# Cursor / VS Code: copy this file to .env.local (same folder as pom.xml), fill values,
# then Run and Debug → "Spring Boot: IslamicLearningCenterApplication" (see .vscode/launch.json).

SPRING_PROFILES_ACTIVE=

SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

SERVER_PORT=

# JWT signing secret for access tokens (>= 32 UTF-8 bytes). Required when the app starts.
APP_JWT_SECRET=
